@page
@using ChatR.Models
@using ChatR.Models.Constatns
@using ChatR.Models.Structure
@model ChatR.Pages.IndexModel
@{
    ViewData["Title"] = "Ваши комнаты";
}

<div class="container mt-4">
    <h3>Добро пожаловать, @Model.CurrentUserEmail!</h3>

    @if (TempData[Messages.SUCCESS] != null)
    {
        <div class="alert alert-success">@TempData[Messages.SUCCESS]</div>
    }
    @if (TempData[Messages.ERROR] != null)
    {
        <div class="alert alert-danger">@TempData[Messages.ERROR]</div>
    }

    <!-- Форма создания комнаты -->
    <div class="card mb-4">
        <div class="card-body">
            <h5>Создать новую комнату</h5>
            <form method="post" asp-page-handler="Create">
                @Html.AntiForgeryToken()
                <div class="input-group">
                    <input type="text"
                           class="form-control"
                           asp-for="NewRoomName"
                           placeholder="Название комнаты"
                           maxlength="100"
                           required />
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Список комнат -->
    <h4>Ваши комнаты</h4>
    @if (Model.UserRooms.Any())
    {
        <div class="list-group" id="roomList">
            @foreach (var room in Model.UserRooms)
            {
                var isAdmin = Model.RoomRoles.TryGetValue(room.Id, out var role) && role == RoomRole.Admin;
                var itemClass = isAdmin ? "list-group-item list-group-item-warning" : "list-group-item";
                <div class="@itemClass d-flex justify-content-between align-items-center">
                    <a href="@Routes.Pages.Chat.Room/@room.Id" class="text-decoration-none text-dark">
                        <strong>@room.Name</strong>
                        @if (isAdmin)
                        {
                            <span class="badge bg-danger ms-2">Админ</span>
                        }
                        <small class="text-muted d-block">
                            Создана: @room.CreatedAt.ToString("dd.MM.yyyy")
                        </small>
                    </a>
                    <div>
                        @if (isAdmin)
                        {
                            <form method="post" asp-page-handler="Delete" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@room.Id" />
                                <button type="submit"
                                        data-id="@room.Id"
                                        class="btn btn-sm btn-outline-danger delete-btn">
                                    Удалить
                                </button>
                            </form>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Leave" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="roomId" value="@room.Id" />
                                <button type="submit"
                                        data-id="@room.Id"
                                        class="btn btn-sm btn-outline-warning leave-btn">
                                    Покинуть
                                </button>
                            </form>
                        }

                        <!-- Кнопка вызова модалки -->
                        <button type="button"
                                class="btn btn-sm btn-outline-success ms-2"
                                data-bs-toggle="modal"
                                data-bs-target="#addMemberModal"
                                data-room-id="@room.Id">
                            Добавить участника
                        </button>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted">У вас пока нет комнат. Создайте первую!</p>
    }
</div>

<!-- Модальное окно -->
<div class="modal fade" id="addMemberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить участника</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="AddMember">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" name="roomId" id="modalRoomId" />

                    <div class="mb-3">
                        <label for="memberSelect" class="form-label">Выберите пользователя</label>
                        <select class="form-select" id="memberSelect" name="SelectedUserId">
                            <option value="">-- Выберите пользователя --</option>
                            @foreach (var user in Model.Following)
                            {
                                <option value="@user.Id">@user.LastName @user.FirstName @user.Patronymic</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                    <button type="submit" class="btn btn-primary">
                        Добавить
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/js/site.js"></script>
    <script src="~/js/chat/roomList.js"></script>
}