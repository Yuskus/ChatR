@page
@using ChatR.Models.Constatns
@using ChatR.Models.Structure
@model ChatR.Pages.Users.AllUsersModel
@{
    ViewData["Title"] = "Все пользователи";
}

<div class="container mt-4">
    <h4 class="mb-4">Все пользователи (@Model.TotalCount)</h4>

    @if (TempData[Messages.ERROR] != null)
    {
        <div class="alert alert-danger">@TempData[Messages.ERROR]</div>
    }

    <!-- Поиск -->
    <form method="get" class="mb-4">
        <div class="input-group feed-block"">
            <input type="text"
                   class="form-control"
                   name="Search"
                   value="@Model.Search"
                   placeholder="Поиск по ФИО..." />
            <button type="submit" class="btn btn-outline-primary">Найти</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-page="@Routes.Pages.Users.AllUsers" class="btn btn-outline-secondary">Сброс</a>
            }
        </div>
    </form>

    @if (Model.Users.Count == 0)
    {
        <p class="text-muted">Пользователи не найдены.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var user in Model.Users)
            {
                <a href="@Routes.Pages.Users.Profile/@user.Id"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                    <div>
                        <strong>@user.LastName @user.FirstName @user.Patronymic</strong>
                        <small class="text-muted d-block">
                            Регистрация: @user.CreatedAt.ToString("dd.MM.yyyy")
                        </small>
                    </div>
                    <small class="text-muted">@(user.LastLogin?.ToString("dd.MM.yyyy") ?? "Не входил(а)")</small>
                </a>
            }
        </div>

        <!-- Пагинация -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <!-- Назад -->
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-page="@Routes.Pages.Users.AllUsers"
                               asp-route-Page="@(Model.CurrentPage - 1)"
                               asp-route-Search="@Model.Search">«</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">«</span></li>
                    }

                    @* Номера страниц *@
                    @{
                        int startPage, endPage;
                        if (Model.TotalPages <= 7)
                        {
                            startPage = 1;
                            endPage = Model.TotalPages;
                        }
                        else
                        {
                            startPage = Model.CurrentPage <= 4 ? 1 : Model.CurrentPage - 2;
                            endPage = startPage + 6;
                            if (endPage > Model.TotalPages)
                            {
                                endPage = Model.TotalPages;
                                startPage = Math.Max(1, endPage - 6);
                            }
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-page="@Routes.Pages.Users.AllUsers"
                               asp-route-Page="@p"
                               asp-route-Search="@Model.Search">@p</a>
                        </li>
                    }

                    <!-- Вперёд -->
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-page="@Routes.Pages.Users.AllUsers"
                               asp-route-PageNumber="@(Model.CurrentPage + 1)"
                               asp-route-Search="@Model.Search">»</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">»</span></li>
                    }
                </ul>
            </nav>
        }
    }
</div>

@section Scripts
{
    <script src="~/js/site.js"></script>
}