@page "{id:int}"
@using ChatR.Models.Constatns
@using ChatR.Models.Structure
@model ChatR.Pages.Users.ProfileModel
@{
    ViewData["Title"] = Model.UserToShow != null
        ? $"Профиль: {Model.UserToShow.FirstName} {Model.UserToShow.LastName}"
        : "Профиль";
}

<div class="container mt-4 profile-block">
    <h4 class="mb-4">Профиль пользователя</h4>

    @if (TempData[Messages.SUCCESS] != null)
    {
        <div class="alert alert-success">@TempData[Messages.SUCCESS]</div>
    }
    @if (TempData[Messages.ERROR] != null)
    {
        <div class="alert alert-danger">@TempData[Messages.ERROR]</div>
    }

    @if (Model.UserToShow == null)
    {
        <div class="alert alert-danger">Пользователь не найден.</div>
    }
    else
    {
        <!-- Карточка профиля -->
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    @if (Model.IsOwnProfile)
                    {
                        <h5 class="card-title text-primary border-bottom pb-2 mb-3 m-0">
                            Личная информация
                        </h5>
                        <a href="@Routes.Pages.Users.EditProfile" class="btn btn-sm btn-outline-primary">
                            ✏️
                        </a>
                    }
                    else
                    {
                        <h5 class="card-title text-primary border-bottom pb-2 mb-3">
                            Информация о пользователе
                        </h5>
                    }
                </div>

                <!-- Таблица информации -->
                <dl class="row mb-0">
                    <dt class="col-sm-4 fw-bold text-muted">Фамилия</dt>
                    <dd class="col-sm-8">@Model.UserToShow.LastName</dd>

                    <dt class="col-sm-4 fw-bold text-muted">Имя</dt>
                    <dd class="col-sm-8">@Model.UserToShow.FirstName</dd>

                    <dt class="col-sm-4 fw-bold text-muted">Отчество</dt>
                    <dd class="col-sm-8">@(Model.UserToShow.Patronymic ?? "-")</dd>
                    
                    <dt class="col-sm-4 fw-bold text-muted">Дата регистрации</dt>
                    <dd class="col-sm-8">@Model.UserToShow.CreatedAt.ToString("dd.MM.yyyy")</dd>

                    <dt class="col-sm-4 fw-bold text-muted">Дата последнего входа:</dt>
                    <dd class="col-sm-8">@(Model.UserToShow.LastLogin?.ToString("dd.MM.yyyy") ?? "-")</dd>
                </dl>
            </div>
        </div>

        <!-- Кнопки подписки и навигации (для всех профилей) -->
        <div class="mb-3">
            <a href="@Routes.Pages.Observings.UsersFrom/@Model.UserToShow.Id" class="btn btn-outline-success btn-sm me-2">
                Подписки (@(Model.UsersFromCount))
            </a>
            <a href="@Routes.Pages.Observings.UsersTo/@Model.UserToShow.Id" class="btn btn-outline-info btn-sm">
                Подписчики (@(Model.UsersToCount))
            </a>
        </div>

        <!-- Кнопки подписки (только для чужих профилей) -->
        @if (!Model.IsOwnProfile)
        {
            <div class="mb-3">
                @if (Model.IsSubscribed)
                {
                    <form method="post" asp-page-handler="Unsubscribe">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            Отписаться
                        </button>
                    </form>
                }
                else
                {
                    <form method="post" asp-page-handler="Subscribe">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary">
                            Подписаться
                        </button>
                    </form>
                }
            </div>
        }

        <!-- Посты на стене -->
        <div id="posts-anchor" data-skip="@Model.Skip"></div>

        @if (Model.TotalPostCount == 0)
        {
            <div class="card shadow-sm mt-4">
                <div class="card-body text-center text-muted py-4">
                    <p class="mb-3">Постов нет</p>

                    @if (Model.IsOwnProfile)
                    {
                        <form method="post" asp-page-handler="Add">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <textarea name="NewPostContent" class="form-control" rows="3"
                                          placeholder="Написать пост..."></textarea>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-sm btn-primary">Добавить пост</button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm mt-4">
                <div class="card-body">
                    <h5 class="card-title text-primary border-bottom pb-2 mb-3">
                        Посты на стене (@Model.TotalPostCount)
                    </h5>

                    <!-- Форма добавления поста (только для своего профиля) -->
                    @if (Model.IsOwnProfile)
                    {
                        <form method="post" asp-page-handler="Add" class="mb-3">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="skip" value="@Model.Skip" />
                            <div class="mb-2">
                                <textarea name="NewPostContent" class="form-control" rows="2"
                                          placeholder="Написать пост..."
                                          asp-for="NewPostContent"></textarea>
                            </div>
                            <div class="text-end">
                                <button type="submit" class="btn btn-sm btn-primary">Опубликовать</button>
                            </div>
                        </form>
                    }

                    @foreach (var post in Model.Posts)
                    {
                        <div class="post-item mb-3 pb-3 border-bottom">
                            <div class="multiline-text">@post.Content</div>
                            <small class="text-muted">@post.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>

                            @if (Model.IsOwnProfile)
                            {
                                <div class="mt-1">
                                    <!-- Кнопка редактирования -->
                                    <button type="button" class="btn btn-sm btn-outline-secondary me-1"
                                            data-bs-toggle="modal" data-bs-target="#editModal"
                                            data-post-id="@post.Id"
                                            data-post-content="@post.Content.Replace("\"", "&quot;")">
                                        ✏️
                                    </button>
                                    <!-- Кнопка удаления -->
                                    <form method="post" asp-page-handler="DeletePost" class="d-inline"
                                          onsubmit="return confirm('Удалить этот пост?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="postId" value="@post.Id" />
                                        <input type="hidden" name="skip" value="@Model.Skip" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">🗑️</button>
                                    </form>
                                </div>
                            }
                        </div>
                    }

                    <!-- Пагинация -->
                    @if (Model.TotalPages > 1)
                    {
                        <nav class="mt-3 pt-2">
                            <ul class="pagination justify-content-center mb-0">
                                <!-- Назад -->
                                @if (Model.CurrentPage > 1)
                                {
                                    var prevSkip = (Model.CurrentPage - 2) * Model.PostsPerPage;
                                    <li class="page-item">
                                        <a class="page-link" href="?skip=@prevSkip">«</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">«</span>
                                    </li>
                                }

                                @* Генерация номеров страниц *@
                                @{
                                    int startPage, endPage;
                                    if (Model.TotalPages <= 7)
                                    {
                                        startPage = 1;
                                        endPage = Model.TotalPages;
                                    }
                                    else
                                    {
                                        startPage = Model.CurrentPage <= 4 ? 1 : Model.CurrentPage - 2;
                                        endPage = startPage + 6;
                                        if (endPage > Model.TotalPages)
                                        {
                                            endPage = Model.TotalPages;
                                            startPage = Math.Max(1, endPage - 6);
                                        }
                                    }
                                }

                                @for (int p = startPage; p <= endPage; p++)
                                {
                                    var pageSkip = (p - 1) * Model.PostsPerPage;
                                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                        <a class="page-link" href="?skip=@pageSkip">@p</a>
                                    </li>
                                }

                                <!-- Вперёд -->
                                @if (Model.CurrentPage < Model.TotalPages)
                                {
                                    var nextSkip = Model.CurrentPage * Model.PostsPerPage;
                                    <li class="page-item">
                                        <a class="page-link" href="?skip=@nextSkip">»</a>
                                    </li>
                                }
                                else
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">»</span>
                                    </li>
                                }
                            </ul>
                        </nav>
                    }
                </div>
            </div>
        }
    }

    <!-- Модальное окно редактирования поста (только если есть посты) -->
    @if (Model.TotalPostCount > 0)
    {
        <div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form method="post" asp-page-handler="Edit">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title" id="editModalLabel">Редактировать пост</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="EditPostId" id="EditPostId" />
                            <div class="mb-3">
                                <textarea name="EditPostContent" id="EditPostContent" class="form-control" rows="4"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                            <button type="submit" class="btn btn-primary">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/posts/list.js"></script>
}
