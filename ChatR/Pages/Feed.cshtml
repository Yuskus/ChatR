@page
@using ChatR.Models.Constatns
@using ChatR.Models.Structure
@model ChatR.Pages.FeedModel
@{
    ViewData["Title"] = "Лента";
}

<div class="container mt-4">
    <h4 class="mb-4">Лента</h4>

    @if (TempData[Messages.ERROR] != null)
    {
        <div class="alert alert-danger">@TempData[Messages.ERROR]</div>
    }

    @if (Model.Posts.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <p class="mb-0">Постов пока нет</p>
                <small>Подпишитесь на пользователей, чтобы видеть их посты</small>
            </div>
        </div>
    }
    else
    {
        @foreach (var post in Model.Posts)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <a href="@Routes.Pages.Users.Profile/@post.UserId" class="text-decoration-none">
                            <strong class="text-primary">@post.User?.LastName @post.User?.FirstName</strong>
                        </a>
                        <small class="text-muted ms-auto">@post.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                    </div>
                    <div class="multiline-text">@post.Content</div>
                </div>
            </div>
        }

        <!-- Пагинация -->
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <!-- Назад -->
                    @if (Model.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-page="@Routes.Pages.Feed"
                               asp-route-PageNumber="@(Model.CurrentPage - 1)">«</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">«</span></li>
                    }

                    @* Номера страниц *@
                    @{
                        int startPage, endPage;
                        if (Model.TotalPages <= 7)
                        {
                            startPage = 1;
                            endPage = Model.TotalPages;
                        }
                        else
                        {
                            startPage = Model.CurrentPage <= 4 ? 1 : Model.CurrentPage - 2;
                            endPage = startPage + 6;
                            if (endPage > Model.TotalPages)
                            {
                                endPage = Model.TotalPages;
                                startPage = Math.Max(1, endPage - 6);
                            }
                        }
                    }

                    @for (int p = startPage; p <= endPage; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-page="@Routes.Pages.Feed"
                               asp-route-PageNumber="@p">@p</a>
                        </li>
                    }

                    <!-- Вперёд -->
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-page="@Routes.Pages.Feed"
                               asp-route-PageNumber="@(Model.CurrentPage + 1)">»</a>
                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled"><span class="page-link">»</span></li>
                    }
                </ul>
            </nav>
        }
    }
</div>
